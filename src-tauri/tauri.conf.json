{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:5173",
    "distDir": "../build"
  },
  "package": {
    "productName": "Holmgard Lore Editor",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "path": { "all": true },
      "protocol": { "asset": true, "assetScope": ["**"] },
      "shell": { "all": false, "open": true },
      "http": {
        "all": true,
        "request": true,
        "scope": ["https://**", "http://localhost/**"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "dev.holmgard.lore-editor",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; connect-src 'self' https://api.anthropic.com https://*.workers.dev https://*.cloudflare.com; font-src 'self'; frame-src 'none'; object-src 'none'"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Holmgard Lore Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  }
}
