# -----------------------------------------------------------------------------
# Holmgard Lore Editor - Environment Configuration Template
# -----------------------------------------------------------------------------

# === ANTHROPIC / CLAUDE API ===
# Required for the agentic lore assistant (src/lib/claude.ts)
CLAUDE_API_KEY=your_anthropic_api_key_here

# === MCP / WORKER INTEGRATION ===
# The URL of your Cloudflare Worker MCP backend
WORKER_HOST=https://holmgard-lore-mcp.frozenregister.workers.dev

# Admin secret used for pushing map data and writing lore (POST /admin/*)
ADMIN_SECRET=your_high_entropy_admin_secret_here

# API Key for reading lore via JSON-RPC/MCP endpoints
MCP_API_KEY=your_mcp_api_key_here

# === VENDOR PIPELINE (Build Time) ===
# JSON array of vendor files to fetch from R2 during 'pnpm vendor:fetch'
# If left blank, the build script falls back to hardcoded public R2 URLs.
VENDOR_MANIFEST='[{"filename":"auth.js","url":"https://pub-ace11385e34e407d98492e19fd3fac06.r2.dev/auth.js"},{"filename":"game.js","url":"https://pub-ace11385e34e407d98492e19fd3fac06.r2.dev/game.js"}]'

# Optional token if your R2 bucket requires Bearer auth
VENDOR_TOKEN=your_r2_access_token_here

# === TAURI / DESKTOP SETTINGS ===
# Prefixed with TAURI_ to be accessible in the Rust backend if needed
TAURI_DEBUG=true

# === DEVELOPMENT ===
# Set to 1 to enable specific map tools in the Claude system prompt
VITE_ENABLE_MAP_TOOLS=0

# -----------------------------------------------------------------------------
# Note: Copy this file to .env and fill in the real values. 
# Never commit your .env file to version control.
# -----------------------------------------------------------------------------