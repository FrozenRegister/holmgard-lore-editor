{
  "name": "holmgard-lore-editor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "vendor:fetch": "node scripts/fetch-deps.mjs",
    "vendor:bundle": "node scripts/bundle-vendor.mjs",
    "vendor:build": "pnpm run vendor:fetch && pnpm run vendor:bundle",
    "vendor:check": "node scripts/check-vendor.mjs",
    "vendor:sync": "node scripts/vendor-sync.mjs",
    "precheck": "node scripts/check-vendor.mjs",
    "check-pr": "node scripts/check-pr-quality.mjs",
    "prepush": "pnpm run check-pr && pnpm run vendor:check",
    "build": "pnpm run vendor:build && vite build && node scripts/patch-csp-headers.mjs",
    "deploy": "pnpm run build && wrangler pages deploy build/ --project-name holmgard-lore-editor --branch main --commit-dirty",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "postinstall": "svelte-kit sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "coverage:gaps": "tsx scripts/coverage-gap-analysis.ts",
    "analyze:map": "tsx scripts/analyze-working-map.ts",
    "ts": "tsx",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.4.0",
    "dexie": "^4.4.3",
    "highlight.js": "^11.9.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "marked": "^9.1.6",
    "marked-highlight": "^2.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@sveltejs/adapter-static": "^3.0.1",
    "@sveltejs/kit": "^2.5.3",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tauri-apps/api": "^1.6.0",
    "@tauri-apps/cli": "^1.6.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/svelte": "^5.1.0",
    "@types/node": "^20.12.7",
    "@vitest/coverage-istanbul": "^1.6.1",
    "@vitest/coverage-v8": "^1.6.0",
    "conventional-changelog-cli": "^5.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.0.0",
    "markdownlint-cli2": "^0.22.1",
    "monaco-editor": "^0.55.1",
    "svelte": "^4.2.20",
    "svelte-check": "^3.6.9",
    "tslib": "^2.6.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0",
    "wrangler": "^4.98.0"
  }
}